<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="RecursosHumanos.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="RecursosHumanos.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <connectionStrings>
    <add name="RecursosHumanos.My.MySettings.CMIConnectionString" connectionString="Data Source=SERVIDOR_SQL;Initial Catalog=CMI;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.diagnostics>
    <sources>
      <source name="DefaultSource" switchName="DefaultSwitch">
        <listeners>
          <add name="FileLog" />
        </listeners>
      </source>
    </sources>
    <switches>
      <add name="DefaultSwitch" value="Information" />
    </switches>
    <sharedListeners>
      <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter" />
    </sharedListeners>
  </system.diagnostics>
  <applicationSettings>
    <RecursosHumanos.My.MySettings>
      <setting name="Usuario" serializeAs="String">
        <value />
      </setting>
      <setting name="BaseDatos" serializeAs="String">
        <value>CMI</value>
      </setting>
      <setting name="Servidor" serializeAs="String">
        <value>server1</value>
      </setting>
      <setting name="AutenticacionIntegrada" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="TiempoConexion" serializeAs="String">
        <value>30</value>
      </setting>
    </RecursosHumanos.My.MySettings>
  </applicationSettings>
  <userSettings>
    <RecursosHumanos.My.MySettings>
      <setting name="AnioActual" serializeAs="String">
        <value>2013</value>
      </setting>
      <setting name="RutaLogo" serializeAs="String">
        <value>D:\Sistema_GRLL\Logo_GRLL.jpg</value>
      </setting>
    </RecursosHumanos.My.MySettings>
  </userSettings>
</configuration>
